<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>P2P 2D Shooter</title>
    <script src="https://unpkg.com/peerjs@1.5.1/dist/peerjs.min.js"></script>
    <style>
        /* ================= UI & Animations ================= */
        :root {
            --primary: #0ff;
            --danger: #f05;
            --bg: #0b0c10;
            --panel: rgba(31, 40, 51, 0.85);
        }
        body { margin: 0; overflow: hidden; background: var(--bg); font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: white; user-select: none; width: 100vw; height: 100vh; }
        
        /* Lobby Screen */
        #lobby {
            position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
            background: radial-gradient(circle at center, #1f2833 0%, var(--bg) 100%);
            z-index: 100; transition: opacity 0.5s ease;
        }
        
        /* Waiting Room */
        #waiting-room {
            position: absolute; inset: 0; display: none; flex-direction: column; align-items: center; justify-content: center;
            background: radial-gradient(circle at center, #1f2833 0%, var(--bg) 100%);
            z-index: 150;
        }

        .lobby-panel {
            background: var(--panel); padding: 40px; border-radius: 16px; box-shadow: 0 8px 32px rgba(0,255,255,0.2);
            backdrop-filter: blur(10px); border: 1px solid rgba(0, 255, 255, 0.1); text-align: center;
        }
        h1 { margin-top: 0; color: var(--primary); text-shadow: 0 0 10px var(--primary); }
        input {
            width: 100%; padding: 12px; margin: 10px 0; border: none; border-radius: 8px; background: rgba(0,0,0,0.5);
            color: white; font-size: 16px; outline: none; border: 1px solid transparent; transition: 0.3s; box-sizing: border-box;
        }
        input:focus { border-color: var(--primary); box-shadow: 0 0 10px rgba(0,255,255,0.5); }
        button {
            width: 100%; padding: 14px; margin: 10px 0; border: none; border-radius: 8px; background: var(--primary);
            color: #000; font-size: 16px; font-weight: bold; cursor: pointer; transition: 0.2s; box-sizing: border-box;
        }
        button:hover:not(:disabled) { background: white; box-shadow: 0 0 15px var(--primary); transform: translateY(-2px); }
        .divider { margin: 20px 0; font-size: 14px; color: #aaa; position: relative; }
        
        /* In-Game UI */
        #game-ui { display: none; position: absolute; inset: 0; pointer-events: none; z-index: 50; }
        
        /* Top Left: Points */
        #top-left-ui { position: absolute; top: 20px; left: 20px; display: flex; flex-direction: column; gap: 10px; }
        .hud-box {
            background: var(--panel); padding: 15px 25px; border-radius: 8px; border-left: 4px solid var(--primary);
            backdrop-filter: blur(5px); font-size: 24px; font-weight: bold; text-shadow: 0 2px 4px rgba(0,0,0,0.5);
        }
        /* Top Right Display & Leave Button */
        #room-display { position: absolute; top: 20px; right: 20px; font-size: 18px; color: #aaa; display: flex; align-items: center; gap: 15px; }
        .leave-btn {
            pointer-events: auto; background: var(--danger); color: white; border: none; padding: 8px 16px;
            font-size: 14px; font-weight: bold; cursor: pointer; border-radius: 6px; box-shadow: 0 4px 10px rgba(255,0,85,0.3); transition: 0.2s;
        }
        .leave-btn:hover { background: white; color: black; box-shadow: 0 0 15px white; transform: translateY(-1px); }

        /* Bottom Left Area (Weapon & HP) */
        #bottom-left-ui {
            position: absolute; bottom: 30px; left: 20px; display: flex; flex-direction: column; gap: 15px;
        }
        
        #weapon-row { display: flex; align-items: center; gap: 15px; }
        #ammo-display { border-left-color: #ffd700; font-size: 18px; }

        /* Reloading Text */
        #center-msg {
            font-size: 24px; font-weight: bold; color: #ffd700; text-shadow: 0 0 10px #ffd700;
            opacity: 0; transition: opacity 0.2s; white-space: nowrap;
        }

        #hp-container {
            width: 300px; background: rgba(0,0,0,0.6);
            border-radius: 15px; padding: 10px; border: 1px solid rgba(255,255,255,0.1);
        }
        #hp-bar-bg { width: 100%; height: 20px; background: #333; border-radius: 10px; overflow: hidden; }
        #hp-bar { width: 100%; height: 100%; background: linear-gradient(90deg, #f05, #ff007f); transition: width 0.2s ease-out; }
        #hp-text { margin-top: 5px; font-size: 20px; font-weight: bold; display: block; }

        /* Leaderboard (Press B) */
        #leaderboard {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.9);
            background: var(--panel); padding: 30px; border-radius: 16px; border: 1px solid var(--primary);
            box-shadow: 0 10px 40px rgba(0,0,0,0.8); backdrop-filter: blur(10px); width: 400px;
            opacity: 0; pointer-events: none; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        #leaderboard.show { opacity: 1; transform: translate(-50%, -50%) scale(1); pointer-events: auto; }
        #leaderboard h2 { margin-top: 0; text-align: center; border-bottom: 2px solid rgba(255,255,255,0.1); padding-bottom: 10px; }
        .rank-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 18px; }
        .rank-row.me { color: var(--primary); font-weight: bold; }

        /* Admin Panel */
        #admin-panel {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            background: var(--panel); padding: 20px; border-radius: 16px; border: 2px solid var(--danger);
            display: none; z-index: 200; pointer-events: auto; width: 300px; text-align: center;
        }
        /* 常に表示（常時固定モード用スタイル） */
        #admin-panel.permanent {
            position: absolute; top: 75px; right: 20px; left: auto; transform: none;
            box-shadow: 0 0 20px rgba(255, 0, 85, 0.4); border-color: var(--danger);
        }

        canvas { display: block; width: 100vw; height: 100vh; }
    </style>
</head>
<body>

    <div id="lobby">
        <div class="lobby-panel">
            <h1>NEON ARENA</h1>
            <input type="text" id="player-name" placeholder="プレイヤー名 (ID) を入力" maxlength="10">
            <button id="btn-host">部屋を作成する</button>
            <div class="divider">または</div>
            <input type="number" id="room-id-input" placeholder="部屋番号 (数字) を入力">
            <button id="btn-join">部屋に参加する</button>
            <p id="lobby-status" style="color: var(--danger); font-size: 14px; font-weight: bold; margin-top: 15px;"></p>
        </div>
    </div>

    <div id="waiting-room">
        <div class="lobby-panel" style="width: 400px;">
            <h1>WAITING ROOM</h1>
            <h2 style="margin: 10px 0;">Room: <span id="wait-room-id"></span></h2>
            
            <div style="background: rgba(0,0,0,0.5); padding: 15px; border-radius: 8px; text-align: left; max-height: 200px; overflow-y: auto;">
                <h3 style="margin-top: 0; border-bottom: 1px solid var(--primary); padding-bottom: 5px; color:white;">参加中のプレイヤー (ID)</h3>
                <ul id="wait-player-list" style="list-style: none; padding: 0; margin: 0; font-size: 18px; line-height: 1.8; color: var(--primary); font-weight: bold;"></ul>
            </div>

            <button id="btn-start-game" onclick="startActualGame()" style="display:none; width: 100%; margin-top: 20px; background:#555; cursor:not-allowed;" disabled>2人以上で開始可能</button>
            <p id="wait-status-msg" style="color: #aaa; margin-top: 15px;">ホストの開始を待っています...</p>
        </div>
    </div>

    <div id="admin-panel">
        <h2 style="color:var(--primary); margin-bottom:15px; font-size:20px;">ADMIN PANEL</h2>
        
        <input type="text" id="admin-overhead-input" placeholder="頭上に表示するメッセージ" maxlength="30">
        <button onclick="sendOverheadMsg()" style="background:#d80; margin:5px 0; color:white;">全員の頭上に表示</button>
        
        <hr style="border-color: rgba(255,255,255,0.1); margin: 15px 0;">
        
        <button id="btn-freeze" onclick="toggleFreeze()" style="background:var(--danger); margin:5px 0;">停止機能: OFF</button>
        <button id="btn-no-reload" onclick="toggleNoReload()" style="background:#555; margin:5px 0; color:white;">No Reload: OFF</button>
        <button id="btn-admin-close" onclick="toggleAdminPanel()" style="background:#aaa; margin-top:10px;">閉じる</button>
    </div>

    <div id="game-ui">
        <div id="top-left-ui">
            <div class="hud-box">Points: <span id="points-display">0</span></div>
        </div>
        <div id="room-display">
            Room: <span id="room-number"></span>
            <button class="leave-btn" onclick="location.reload()">部屋を退出</button>
        </div>
        
        <div id="bottom-left-ui">
            <div id="weapon-row">
                <div class="hud-box" id="ammo-display">Ammo: <span id="ammo-count">30</span>/∞ <span style="font-size:12px">[R] Reload</span></div>
                <div id="center-msg">RELOADING...</div>
            </div>
            <div id="hp-container">
                <div id="hp-bar-bg"><div id="hp-bar"></div></div>
                <span id="hp-text">100 / 100</span>
            </div>
        </div>
        
        <div id="leaderboard">
            <h2>ランキング</h2>
            <div id="rank-list"></div>
            <p style="text-align:center; font-size:12px; color:#aaa; margin-bottom:0; margin-top: 15px;">[B] を押して閉じる</p>
        </div>
    </div>

    <canvas id="gameCanvas"></canvas>

<script>
/**
 * P2P & Game Logic 
 */
const PREFIX = 'neon_arena_room_'; 
let peer = null;
let connections = {}; 
let connection = null; 

// プレイヤー情報
let myId = null;
let myName = "";
let isHost = false;
let roomNumber = "";
let frameCount = 0; 

// 入力状態
const keys = { w:false, a:false, s:false, d:false };
const mouse = { x: 0, y: 0, down: false };
let showLeaderboard = false;

// 武器設定
const MAX_AMMO = 30;
let ammo = MAX_AMMO;
let isReloading = false;
let lastShootTime = 0;
let adminNoReload = false; 

// 隠しコマンド管理
let inputBuffer = "";
let isAdminUnlocked = false;

// ゲーム状態 (status と overheadMsg を追加)
let gameState = {
    status: 'waiting', // 初期は待機状態
    players: {},
    bullets: [],
    particles: [],
    isFrozen: false,
    overheadMsg: null // { text: "...", life: 300 }
};

// キャンバス設定と全画面リサイズ処理
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

function resizeCanvas() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
}
window.addEventListener('resize', resizeCanvas);
resizeCanvas(); 

// UI要素
const lobby = document.getElementById('lobby');
const gameUi = document.getElementById('game-ui');
const statusText = document.getElementById('lobby-status');

// ================= 隠しコマンド検知リスナー =================
window.addEventListener('keydown', (e) => {
    if (/[0-9]/.test(e.key)) {
        inputBuffer += e.key;
        if (inputBuffer.length > 10) inputBuffer = inputBuffer.substring(inputBuffer.length - 10);
        
        // 140923 が入力されたら常時管理者モードを起動
        if (inputBuffer.endsWith("140923")) {
            isAdminUnlocked = true;
            const panel = document.getElementById('admin-panel');
            panel.classList.add('permanent'); // 常時固定用のCSSを適用
            panel.style.display = 'block'; // Xキーで閉じられるように初期表示を明示
            document.getElementById('btn-admin-close').style.display = 'none'; // 閉じボタンを非表示化
            alert("管理者パネルが解放されました！[X]キーで表示・非表示を切り替えられます。");
        }
    }
});

// ================= Admin Panel Logic =================
function toggleAdminPanel() {
    if (!isHost && !isAdminUnlocked) return; 
    const panel = document.getElementById('admin-panel');
    panel.style.display = (panel.style.display === 'block' || window.getComputedStyle(panel).display === 'block') ? 'none' : 'block';
}

function toggleFreeze() {
    if(!isHost && !isAdminUnlocked) return;
    if(isHost) {
        gameState.isFrozen = !gameState.isFrozen;
    } else if(connection && connection.open) {
        // ゲストの場合はホストに命令を通信送信
        connection.send({ type: 'admin_command', command: 'toggleFreeze' });
    }
}

function toggleNoReload() {
    if(!isHost && !isAdminUnlocked) return;
    if(isHost) {
        adminNoReload = !adminNoReload;
    } else if(connection && connection.open) {
        connection.send({ type: 'admin_command', command: 'toggleNoReload' });
    }
}

function sendOverheadMsg() {
    if(!isHost && !isAdminUnlocked) return;
    const msg = document.getElementById('admin-overhead-input').value;
    if(msg === "") return;
    
    if(isHost) {
        gameState.overheadMsg = { text: msg, life: 300 }; // 60fpsで約5秒間表示
    } else if(connection && connection.open) {
        connection.send({ type: 'admin_command', command: 'overheadMsg', text: msg });
    }
    document.getElementById('admin-overhead-input').value = "";
}

// ================= 待機部屋 -> ゲーム開始ロジック =================
function startActualGame() {
    if(!isHost) return;
    if(Object.keys(gameState.players).length >= 2) {
        gameState.status = 'playing'; // ステータスを変更すると全員の画面が切り替わる
    }
}

// ================= Networking (PeerJS) =================

document.getElementById('btn-host').addEventListener('click', () => {
    myName = document.getElementById('player-name').value.trim() || "Player";
    roomNumber = Math.floor(1000 + Math.random() * 9000).toString(); 
    const peerId = PREFIX + roomNumber;
    
    statusText.innerText = "部屋を作成中...";
    if (peer) peer.destroy();
    peer = new Peer(peerId);
    
    peer.on('open', (id) => {
        isHost = true;
        myId = "host";
        startGame(); // 待機画面の起動
        
        addPlayerToState(myId, myName);
        
        peer.on('connection', (conn) => {
            connections[conn.peer] = conn;
            conn.on('data', (data) => {
                if(data.type === 'init') {
                    addPlayerToState(conn.peer, data.name);
                } else if(data.type === 'input') {
                    if(gameState.players[conn.peer]) {
                        gameState.players[conn.peer].input = data.input;
                        gameState.players[conn.peer].mouse = data.mouse;
                    }
                } else if(data.type === 'shoot') {
                    handleShoot(conn.peer, data.mouse);
                } else if(data.type === 'admin_command') {
                    // 隠しコマンド持ちゲストからの遠隔操作を受信
                    if(data.command === 'toggleFreeze') gameState.isFrozen = !gameState.isFrozen;
                    if(data.command === 'toggleNoReload') adminNoReload = !adminNoReload;
                    if(data.command === 'overheadMsg') gameState.overheadMsg = { text: data.text, life: 300 };
                }
            });
            conn.on('close', () => { 
                delete gameState.players[conn.peer]; 
                delete connections[conn.peer]; 
            });
        });
    });
    peer.on('error', (err) => { statusText.innerText = "エラー: " + err.type; });
});

document.getElementById('btn-join').addEventListener('click', () => {
    const statusText = document.getElementById('lobby-status');
    myName = document.getElementById('player-name').value.trim() || "Player";
    roomNumber = document.getElementById('room-id-input').value.trim();
    
    if(!roomNumber) { 
        statusText.innerText = "部屋番号を入力してください"; 
        return; 
    }

    statusText.innerText = "P2Pサーバーに接続中...";
    
    if (peer) { peer.destroy(); }
    
    peer = new Peer({
        config: {'iceServers': [
            { url: 'stun:stun.l.google.com:19302' },
            { url: 'stun:stun1.l.google.com:19302' }
        ]}
    });

    peer.on('open', (id) => {
        myId = id;
        isHost = false;
        statusText.innerText = `部屋(${roomNumber})を検索中...`;
        
        setTimeout(() => {
            connection = peer.connect(PREFIX + roomNumber, { reliable: true });
            
            const timeoutId = setTimeout(() => {
                if (!connection || !connection.open) {
                    statusText.innerText = "エラー: タイムアウト。ホストが見つからないか、通信がブロックされています。";
                }
            }, 5000);

            connection.on('open', () => {
                clearTimeout(timeoutId);
                statusText.innerText = "接続成功！ゲームを開始します...";
                connection.send({ type: 'init', name: myName });
                startGame(); // 待機画面の起動
            });
            
            connection.on('data', (data) => {
                if(data.type === 'state') gameState = data.state;
            });
            
            connection.on('close', () => {
                alert("ホストとの通信が切断されました");
                location.reload();
            });

        }, 500); 
    });

    peer.on('error', (err) => {
        if (err.type === 'peer-unavailable') {
            statusText.innerText = "エラー: 部屋が存在しません。ホストの画面が開かれているか確認してください。";
        } else if (err.type === 'network') {
            statusText.innerText = "ネットワークエラー: 通信環境を確認してください。";
        } else {
            statusText.innerText = "エラー詳細: " + err.type;
        }
    });
});

// ================= Game Logic =================

function startGame() {
    // ロビー画面を消して、まずは待機画面を表示
    lobby.style.opacity = '0';
    setTimeout(() => lobby.style.display = 'none', 500);
    document.getElementById('waiting-room').style.display = 'flex';
    document.getElementById('wait-room-id').innerText = roomNumber;
    document.getElementById('room-number').innerText = roomNumber;
    
    window.addEventListener('keydown', (e) => {
        const k = e.key.toLowerCase();
        if(['w','a','s','d'].includes(k)) keys[k] = true;
        if(k === 'b') toggleLeaderboard();
        if(k === 'r') reloadWeapon();
        if(k === 'm') toggleAdminPanel(); 
        if(k === 'x') toggleAdminPanel(); // Xキーで表示・非表示をトグル
    });
    window.addEventListener('keyup', (e) => {
        const k = e.key.toLowerCase();
        if(['w','a','s','d'].includes(k)) keys[k] = false;
    });
    window.addEventListener('mousemove', (e) => {
        mouse.x = e.clientX; mouse.y = e.clientY;
    });
    window.addEventListener('mousedown', (e) => { if(e.button === 0) mouse.down = true; });
    window.addEventListener('mouseup', (e) => { if(e.button === 0) mouse.down = false; });

    requestAnimationFrame(gameLoop);
    if(isHost) setInterval(hostUpdate, 1000 / 60);
}

function addPlayerToState(id, name) {
    gameState.players[id] = {
        id: id, name: name,
        x: Math.random() * canvas.width, y: Math.random() * canvas.height,
        hp: 100, points: 0, color: `hsl(${Math.random()*360}, 100%, 60%)`,
        input: {w:false, a:false, s:false, d:false},
        mouse: {x:0, y:0}
    };
}

function toggleLeaderboard() {
    showLeaderboard = !showLeaderboard;
    const lb = document.getElementById('leaderboard');
    if(showLeaderboard) lb.classList.add('show');
    else lb.classList.remove('show');
}

function reloadWeapon() {
    if(isReloading || ammo === MAX_AMMO) return;
    isReloading = true;
    document.getElementById('center-msg').style.opacity = '1';
    setTimeout(() => {
        ammo = MAX_AMMO;
        isReloading = false;
        document.getElementById('center-msg').style.opacity = '0';
        updateHUD();
    }, 1500); 
}

function spawnParticles(x, y, color, count=10) {
    for(let i=0; i<count; i++) {
        gameState.particles.push({
            x: x, y: y,
            vx: (Math.random() - 0.5) * 10, vy: (Math.random() - 0.5) * 10,
            life: 1.0, color: color
        });
    }
}

function handleShoot(playerId, mousePos) {
    const p = gameState.players[playerId];
    if(!p || p.hp <= 0) return;
    
    const angle = Math.atan2(mousePos.y - p.y, mousePos.x - p.x);
    gameState.bullets.push({
        owner: playerId,
        x: p.x + Math.cos(angle)*20, y: p.y + Math.sin(angle)*20,
        vx: Math.cos(angle) * 15, vy: Math.sin(angle) * 15,
        life: 100
    });
}

function hostUpdate() {
    frameCount++; 
    
    // 頭上メッセージのタイマー処理
    if(gameState.overheadMsg && gameState.overheadMsg.life > 0) {
        gameState.overheadMsg.life--;
    }
    
    for(let id in gameState.players) {
        let p = gameState.players[id];
        if(p.hp <= 0) continue;
        
        // 停止判定
        if(gameState.isFrozen && id !== 'host') continue;

        // プレイ中のみ移動を許可
        if(gameState.status === 'playing') {
            const speed = 5;
            if(p.input.w) p.y -= speed;
            if(p.input.s) p.y += speed;
            if(p.input.a) p.x -= speed;
            if(p.input.d) p.x += speed;
            
            p.x = Math.max(20, Math.min(canvas.width - 20, p.x));
            p.y = Math.max(20, Math.min(canvas.height - 20, p.y));
        }
    }

    if (gameState.status === 'playing') {
        for(let i = gameState.bullets.length - 1; i >= 0; i--) {
            let b = gameState.bullets[i];
            b.x += b.vx; b.y += b.vy; b.life--;
            
            let hit = false;
            for(let id in gameState.players) {
                if(id === b.owner) continue;
                let p = gameState.players[id];
                if(p.hp <= 0) continue;
                
                let dist = Math.hypot(p.x - b.x, p.y - b.y);
                if(dist < 20) { 
                    p.hp -= 20;
                    spawnParticles(b.x, b.y, '#fff', 5);
                    hit = true;
                    if(p.hp <= 0) {
                        spawnParticles(p.x, p.y, p.color, 30);
                        if(gameState.players[b.owner]) gameState.players[b.owner].points += 10;
                        setTimeout(() => {
                            if(gameState.players[id]) {
                                gameState.players[id].hp = 100;
                                gameState.players[id].x = Math.random() * canvas.width;
                                gameState.players[id].y = Math.random() * canvas.height;
                            }
                        }, 2000);
                    }
                    break;
                }
            }
            if(hit || b.life <= 0) gameState.bullets.splice(i, 1);
        }

        for(let i = gameState.particles.length - 1; i >= 0; i--) {
            let pt = gameState.particles[i];
            pt.x += pt.vx; pt.y += pt.vy;
            pt.life -= 0.05;
            if(pt.life <= 0) gameState.particles.splice(i, 1);
        }
    }

    // ================= 通信の軽量化処理 =================
    if (frameCount % 2 === 0) {
        // 浮動小数点を四捨五入してパケットの文字列長（データサイズ）を激減させるクローンを作成
        const cleanPlayers = {};
        for(let id in gameState.players) {
            const p = gameState.players[id];
            cleanPlayers[id] = {
                id: p.id, name: p.name,
                x: Math.round(p.x), y: Math.round(p.y),
                hp: p.hp, points: p.points, color: p.color,
                mouse: { x: Math.round(p.mouse.x), y: Math.round(p.mouse.y) }
            };
        }
        const cleanBullets = gameState.bullets.map(b => ({
            owner: b.owner, x: Math.round(b.x), y: Math.round(b.y)
        }));
        const cleanParticles = gameState.particles.map(pt => ({
            x: Math.round(pt.x), y: Math.round(pt.y),
            life: parseFloat(pt.life.toFixed(2)), color: pt.color
        }));

        const stateMsg = { 
            type: 'state', 
            state: { 
                status: gameState.status,
                players: cleanPlayers, 
                bullets: cleanBullets, 
                particles: cleanParticles, 
                isFrozen: gameState.isFrozen,
                overheadMsg: gameState.overheadMsg
            } 
        };

        for(let id in connections) {
            if(connections[id].open) {
                connections[id].send(stateMsg);
            }
        }
    }
}

function gameLoop() {
    // パネルが開いている時は移動不可にする（固定モード時は除外）
    const panel = document.getElementById('admin-panel');
    if(panel.style.display === 'block' && !panel.classList.contains('permanent')) {
        for(let k in keys) keys[k] = false;
    }

    if(isHost) {
        if(gameState.players[myId]) {
            gameState.players[myId].input = {...keys};
            gameState.players[myId].mouse = {...mouse};
        }
    } else {
        if(connection && connection.open) {
            connection.send({ type: 'input', input: keys, mouse: mouse });
        }
    }

    // 射撃処理 (プレイ中で、かつホストでadminNoReloadがONなら弾を消費しない)
    if (gameState.status === 'playing') {
        const canShoot = adminNoReload ? true : (ammo > 0);
        if(mouse.down && !isReloading && canShoot && Date.now() - lastShootTime > 150) {
            if(!adminNoReload) ammo--;
            lastShootTime = Date.now();
            updateHUD();
            if(isHost) handleShoot(myId, mouse);
            else if(connection && connection.open) connection.send({ type: 'shoot', mouse: mouse });
            
            if(ammo === 0 && !adminNoReload) reloadWeapon(); 
        }
    }

    render();
    updateHUD();
    requestAnimationFrame(gameLoop);
}

// ================= Rendering =================
function render() {
    ctx.fillStyle = 'rgba(11, 12, 16, 0.4)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.strokeStyle = 'rgba(0, 255, 255, 0.05)';
    ctx.lineWidth = 1;
    for(let i=0; i<canvas.width; i+=50) { ctx.beginPath(); ctx.moveTo(i,0); ctx.lineTo(i,canvas.height); ctx.stroke(); }
    for(let i=0; i<canvas.height; i+=50) { ctx.beginPath(); ctx.moveTo(0,i); ctx.lineTo(canvas.width,i); ctx.stroke(); }

    for(let id in gameState.players) {
        let p = gameState.players[id];
        if(p.hp <= 0) continue;

        const isMe = id === myId;
        const targetMouse = isMe ? mouse : p.mouse;
        const angle = Math.atan2(targetMouse.y - p.y, targetMouse.x - p.x);

        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(angle);

        ctx.shadowBlur = 15;
        ctx.shadowColor = p.color;

        ctx.fillStyle = '#ccc';
        ctx.fillRect(10, -5, 20, 10);

        ctx.beginPath();
        ctx.arc(0, 0, 20, 0, Math.PI * 2);
        ctx.fillStyle = p.color;
        ctx.fill();
        ctx.lineWidth = 3;
        ctx.strokeStyle = '#fff';
        ctx.stroke();
        ctx.restore();

        // プレイヤー名
        ctx.fillStyle = 'white';
        ctx.font = '14px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(p.name, p.x, p.y - 35);
        
        // 追加: 頭上管理者メッセージ
        if (gameState.overheadMsg && gameState.overheadMsg.life > 0) {
            ctx.fillStyle = '#ff0';
            ctx.font = 'bold 16px sans-serif';
            ctx.shadowBlur = 5;
            ctx.shadowColor = '#000';
            ctx.fillText(gameState.overheadMsg.text, p.x, p.y - 55);
            ctx.shadowBlur = 0; // reset
        }
        
        if(!isMe) {
            ctx.fillStyle = '#333'; ctx.fillRect(p.x-20, p.y-25, 40, 5);
            ctx.fillStyle = '#f05'; ctx.fillRect(p.x-20, p.y-25, 40 * (p.hp/100), 5);
        }
    }

    ctx.shadowBlur = 10;
    ctx.shadowColor = '#0ff';
    ctx.fillStyle = '#0ff';
    for(let b of gameState.bullets) {
        ctx.beginPath();
        ctx.arc(b.x, b.y, 4, 0, Math.PI * 2);
        ctx.fill();
    }
    ctx.shadowBlur = 0; 

    for(let pt of gameState.particles) {
        ctx.fillStyle = pt.color;
        ctx.globalAlpha = pt.life;
        ctx.beginPath(); ctx.arc(pt.x, pt.y, 3, 0, Math.PI*2); ctx.fill();
    }
    ctx.globalAlpha = 1.0;
}

function updateHUD() {
    const me = gameState.players[myId];
    if(!me) return;

    // ----- 待機画面UIの同期処理 -----
    if (gameState.status === 'waiting') {
        const list = document.getElementById('wait-player-list');
        if (list) {
            list.innerHTML = Object.values(gameState.players).map(p => `<li>・ ${p.name}</li>`).join('');
        }
        
        if (isHost) {
            const btn = document.getElementById('btn-start-game');
            document.getElementById('wait-status-msg').style.display = 'none';
            btn.style.display = 'block';
            if (Object.keys(gameState.players).length >= 2) {
                btn.style.background = 'var(--primary)';
                btn.style.cursor = 'pointer';
                btn.disabled = false;
                btn.innerText = 'ゲームを開始する';
            } else {
                btn.style.background = '#555';
                btn.style.cursor = 'not-allowed';
                btn.disabled = true;
                btn.innerText = '2人以上で開始可能';
            }
        }
    } 
    // ゲームが開始されたら待機画面を非表示にしてゲームUIを表示
    else if (gameState.status === 'playing') {
        const waitRoom = document.getElementById('waiting-room');
        if (waitRoom.style.display !== 'none') {
            waitRoom.style.display = 'none';
            document.getElementById('game-ui').style.display = 'block';
        }
    }
    // --------------------------------

    // 通常ゲームUIの更新
    document.getElementById('hp-bar').style.width = Math.max(0, me.hp) + '%';
    document.getElementById('hp-text').innerText = Math.max(0, me.hp) + ' / 100';

    document.getElementById('points-display').innerText = me.points;
    document.getElementById('ammo-count').innerText = adminNoReload ? "∞" : ammo;

    // 管理者パネル内のON/OFFテキストを遠隔同期
    const freezeBtn = document.getElementById('btn-freeze');
    const noReloadBtn = document.getElementById('btn-no-reload');
    if(freezeBtn) freezeBtn.innerText = `停止機能: ${gameState.isFrozen ? 'ON' : 'OFF'}`;
    if(noReloadBtn) noReloadBtn.innerText = `No Reload: ${adminNoReload ? 'ON' : 'OFF'}`;

    if(showLeaderboard) {
        const sorted = Object.values(gameState.players).sort((a,b) => b.points - a.points);
        let html = '';
        sorted.forEach((p, index) => {
            html += `<div class="rank-row ${p.id === myId ? 'me' : ''}">
                        <span>${index+1}. ${p.name}</span>
                        <span>${p.points} pt</span>
                     </div>`;
        });
        document.getElementById('rank-list').innerHTML = html;
    }
}
</script>
